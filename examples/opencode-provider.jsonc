{
  // Use opencode2api as a provider inside another OpenCode instance.
  // Copy into ~/.config/opencode/opencode.jsonc and restart that instance.
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "bridge": {
      "name": "opencode2api",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["BRIDGE_API_KEY"],
      "settings": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        // Use any model id returned by http://127.0.0.1:8787/v1/models
        "flint-40b-free": {
          "name": "Flint 40B (via bridge)"
        }
      }
    }
  },

  "model": "bridge/flint-40b-free"
}
