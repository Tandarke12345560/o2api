{
  // Use o2api as a provider inside another OpenCode instance.
  // Copy into ~/.config/opencode/opencode.jsonc and restart that instance.
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "bridge": {
      "name": "o2api",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["BRIDGE_API_KEY"],
      "settings": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        // Use any model id returned by http://127.0.0.1:8787/v1/models.
        // Copy the real limits from that response; without them OpenCode
        // assumes 200k context / 32k output and may exceed the real model.
        "flint-40b-free": {
          "name": "Flint 40B (via bridge)",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        }
      }
    }
  },

  "model": "bridge/flint-40b-free"
}
