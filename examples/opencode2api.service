# /etc/systemd/system/o2api.service
#
# sudo systemctl daemon-reload
# sudo systemctl enable --now o2api
# journalctl -u o2api -f

[Unit]
Description=o2api - OpenAI-compatible API for OpenCode
After=network.target

[Service]
Type=simple
# Run as the same user that owns ~/.config/opencode/service.json
User=%i
WorkingDirectory=/opt/o2api
ExecStart=/usr/bin/node /opt/o2api/server.mjs --port 8787 --host 127.0.0.1
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
